+	audio->runFor(100);
+	CHECK(audio->isCurrentlyPlaying(first));
+	audio->removeAudioEvent(first);
+	audio->runFor(100);
+	CHECK(!audio->isCurrentlyPlaying(first));
+	CHECK(audio->isCurrentlyPlaying(second));
+	audio->reset();
