+            TheGameLogic->isInGame() && !TheGameLogic->isInShellGame(),TheGameLogic->isInMultiplayerGame(),
+            TheGameLogic->isInReplayGame()) || !Direct3D11_Is_Active()) return;
+    WaterRenderBridge::Bridge *bridge=WaterRenderBridge::GetActiveBridge();
+    WaterRenderBridge::CurrentView before={},after={};
+    const bool validBefore=bridge && bridge->QueryCurrentView(before) && WaterRenderBridge::ValidCurrentView(before);
+    const bool validAfter=bridge && bridge->QueryCurrentView(after) && WaterRenderBridge::ValidCurrentView(after);
+    const bool stable=validBefore && validAfter && before.frameId==after.frameId &&
+        before.resourceGeneration==after.resourceGeneration && before.captureSerial==after.captureSerial &&
+        before.colourIdentity==after.colourIdentity && before.depthIdentity==after.depthIdentity &&
+        before.viewIdentity==after.viewIdentity && before.targetWidth==after.targetWidth &&
+        before.targetHeight==after.targetHeight && before.targetFormat==after.targetFormat &&
+        before.targetSamples==after.targetSamples && WaterRenderBridge::SameViewState(before.viewState,after.viewState);
+    std::fprintf(stderr,"sorted-native-witness: queue frame=%u logic=%u system=%u template=%s drawable=%u object=%u array=%p offset=%u quads=%u skipped=0 "
+        "view-before=(valid:%d frame:%llu generation:%llu capture:%llu colour:%llu depth:%llu identity:%llu target:%u,%u,%u,%u) "
+        "view-after=(valid:%d frame:%llu generation:%llu capture:%llu colour:%llu depth:%llu identity:%llu target:%u,%u,%u,%u) view-stable=%d\n",
+        WW3D::Get_Frame_Count(),TheGameLogic->getFrame(),(UnsignedInt)sys->getSystemID(),sys->getTemplate()->getName().str(),
+        (UnsignedInt)sys->getAttachedDrawable(),(UnsignedInt)sys->getAttachedObject(),
+        static_cast<void *>(range.Array),unsigned(range.Offset),quads,
+        (int)validBefore,(unsigned long long)before.frameId,(unsigned long long)before.resourceGeneration,
+        (unsigned long long)before.captureSerial,(unsigned long long)before.colourIdentity,
+        (unsigned long long)before.depthIdentity,(unsigned long long)before.viewIdentity,
+        before.targetWidth,before.targetHeight,before.targetFormat,before.targetSamples,
+        (int)validAfter,(unsigned long long)after.frameId,(unsigned long long)after.resourceGeneration,
+        (unsigned long long)after.captureSerial,(unsigned long long)after.colourIdentity,
+        (unsigned long long)after.depthIdentity,(unsigned long long)after.viewIdentity,
+        after.targetWidth,after.targetHeight,after.targetFormat,after.targetSamples,(int)stable);
+}
