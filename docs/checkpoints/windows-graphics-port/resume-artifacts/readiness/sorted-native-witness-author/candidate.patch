+static void traceSortedNativeQueue(ParticleSystem *sys,const PointGroupClass::SortingBillboardRange &range,unsigned quads)
+{
+    static const char *filter=std::getenv("ZH_WATER_PARTICLE_TRACE_TEMPLATE");
+    if(!sys || !sys->getTemplate() || !filter ||
