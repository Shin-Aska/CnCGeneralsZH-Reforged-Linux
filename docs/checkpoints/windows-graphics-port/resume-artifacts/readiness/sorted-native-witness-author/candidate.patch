+        sys->getAttachedDrawable()!=INVALID_DRAWABLE_ID || sys->getAttachedObject()!=INVALID_ID ||
+        !SortedNativeWitnessRow()) return;
+    if(!TheGlobalData || !TheGameLogic || !TheGameClient ||
