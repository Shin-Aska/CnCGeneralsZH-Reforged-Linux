+// sorted-native-witness begin: diagnostic only, fixed three-frame window.
+static bool SortedNativeWitnessRow()
+{
+    static const char *option=std::getenv("ZH_SORTED_NATIVE_WITNESS");
+    if(!option || std::strcmp(option,"1")!=0) return false;
+    const unsigned frame=WW3D::Get_Frame_Count();
+    if(frame<390 || frame>392) return false;
+    static unsigned priorFrame=0,rows=0;
+    if(priorFrame!=frame) { priorFrame=frame; rows=0; }
+    if(rows==512) {
+        ++rows;
+        std::fprintf(stderr,"sorted-native-witness: INVALID overflow frame=%u limit=512\n",frame);
+    }
+    if(rows>=512) return false;
+    ++rows;
+    return true;
+}
