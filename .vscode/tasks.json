{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Linux: Build Release",
      "type": "process",
      "command": "${workspaceFolder}/build-linux.sh",
      "args": ["Release"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "CC": "gcc-16",
          "CXX": "g++-16"
        }
      },
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
